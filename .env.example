# Custom Clothing Platform - Environment Variables
# If VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY are not set,
# the application automatically runs in Local Development Mode (Offline Storage).

# Supabase Project URL (Optional for local mode)
VITE_SUPABASE_URL=

# Supabase Anon Public Key (Optional for local mode - never use service_role key here!)
VITE_SUPABASE_ANON_KEY=

# Application Mode: 'development' | 'production'
VITE_APP_ENV=development
